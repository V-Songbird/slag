    {
      "name": "jig",
      "source": "./jig",
      "description": "Interviews you about the mistakes that keep landing in your repo, then installs reviewed, reversible guardrails: a committed check script any teammate or CI can run, plus session guards that observe first and can be armed to block once their clean record is in. Writes nothing into any file you own.",
      "version": "1.0.1",
      "license": "MIT",
