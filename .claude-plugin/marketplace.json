        "questions",
        "ambiguity",
        "requirements",
        "scoping",
        "prompt",
        "unknowns",
        "interview"
      ],
      "strict": true
    },
    {
      "name": "brink",
      "source": "./brink",
      "description": "Watches how full the context window is getting and, once you near the edge, nudges you to run /compact with a ready-made instruction — so the summary keeps the current task, decisions, and errors instead of an automatic guess.",
      "version": "0.5.0-alpha",
      "license": "MIT",
      "author": {
        "name": "Victor Villegas",
        "email": "victor.villegas@tuta.com"
      },
      "homepage": "https://github.com/V-Songbird/slag/tree/main/brink",
      "repository": "https://github.com/V-Songbird/slag",
      "category": "workflow",
      "keywords": [
        "context-window",
        "compact",
        "compaction",
        "tokens",
        "session",
        "hooks",
        "nudge"
      ],
