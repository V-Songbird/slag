{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "slag",
  "description": "Experimental agentic plugins and tools that are not meant for public consumption.",
  "owner": {
    "name": "Victor Villegas",
    "email": "victor.villegas@tuta.com"
  },
  "plugins": [
    {
      "name": "assay",
      "source": "./assay",
      "description": "Analyzes the instruction files an agent loads — CLAUDE.md, .claude/rules/, AGENTS.md, skills and hooks — flagging what is vague, stale, buried, or better served by a mechanism, and rewriting the weak ones. /assay:claude and /assay:codex audit a host each; craft-rules and craft-skill write new ones.",
      "version": "1.10.0",
      "license": "MIT",
      "author": {
        "name": "Victor Villegas",
        "email": "victor.villegas@tuta.com"
      },
      "homepage": "https://github.com/V-Songbird/slag/tree/main/assay",
      "repository": "https://github.com/V-Songbird/slag",
      "category": "quality",
      "keywords": [
        "rules",
        "CLAUDE.md",
        "audit",
        "quality",
        "instructions",
        "scoring",
        "hooks",
        "placement",
        "skills"
      ],
      "tags": [
        "rules",
        "CLAUDE.md",
        "audit",
        "quality",
        "instructions",
        "scoring",
        "hooks",
        "placement",
        "skills"
      ],
      "strict": true
    },
    {
      "name": "verity",
      "source": "./verity",
      "description": "Fetches current official Claude Code documentation on demand, giving Claude truth-grounding from primary sources instead of training memory.",
      "version": "0.1.3-alpha",
      "license": "MIT",
      "author": {
        "name": "Victor Villegas",
        "email": "victor.villegas@tuta.com"
      },
