{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/safety-guard.js\" claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/instruction-guard.js\" claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
