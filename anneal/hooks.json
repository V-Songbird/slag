{
  "anneal": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/safety-guard.js antigravity",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/instruction-guard.js antigravity",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
