{
  "schemaVersion": 3,
  "editions": [
    {
      "id": "dotnet",
      "displayName": "C# / .NET (dotnet CLI, csproj, NuGet)",
      "file": "dotnet.json",
      "classCount": 24,
      "detect": {
        "files": [
          "*.csproj",
          "*.sln",
          "*.slnx",
          "Directory.Build.props",
          "Directory.Packages.props",
          "global.json",
          "nuget.config"
        ],
        "extensions": [
          ".cs",
          ".csproj",
          ".props",
          ".targets",
          ".runsettings",
          ".sln"
        ],
        "commentSyntax": {
          ".cs": "slash",
          ".csproj": "none",
          ".props": "none",
          ".targets": "none",
          ".runsettings": "none",
          ".sln": "hash"
        },
        "packageManagers": [
          "dotnet",
          "nuget"
        ]
      }
    },
    {
      "id": "go",
      "displayName": "Go (go modules, go toolchain)",
      "file": "go.json",
      "classCount": 23,
      "detect": {
        "files": [
          "go.mod",
          "go.sum",
          "go.work"
        ],
        "extensions": [
          ".go",
          ".mod",
          ".sum",
          ".work"
        ],
        "commentSyntax": {
          ".go": "slash",
          ".mod": "slash",
          ".sum": "none",
          ".work": "slash"
        },
        "packageManagers": [
          "go"
        ]
      }
    },
    {
      "id": "javascript-typescript",
      "displayName": "JavaScript & TypeScript",
      "file": "javascript-typescript.json",
      "classCount": 25,
      "detect": {
        "files": [
          "package.json",
          "tsconfig.json",
          "pnpm-lock.yaml",
          "yarn.lock",
          "package-lock.json",
          "bun.lock"
        ],
        "extensions": [
          ".js",
          ".mjs",
          ".cjs",
          ".jsx",
          ".ts",
          ".mts",
          ".cts",
          ".tsx"
        ],
        "commentSyntax": {
          ".js": "slash",
          ".mjs": "slash",
          ".cjs": "slash",
          ".jsx": "slash",
          ".ts": "slash",
          ".mts": "slash",
          ".cts": "slash",
          ".tsx": "slash"
        },
        "packageManagers": [
          "npm",
          "pnpm",
          "yarn",
          "bun"
        ]
      }
    },
    {
      "id": "jvm",
      "displayName": "Java & Kotlin (Gradle / Maven)",
      "file": "jvm.json",
      "classCount": 21,
      "detect": {
        "files": [
          "build.gradle.kts",
          "build.gradle",
          "settings.gradle.kts",
          "settings.gradle",
          "pom.xml",
          "gradlew"
        ],
        "extensions": [
          ".java",
          ".kt",
          ".kts",
          ".gradle"
        ],
        "commentSyntax": {
          ".java": "slash",
          ".kt": "slash",
          ".kts": "slash",
          ".gradle": "slash"
        },
        "packageManagers": [
          "gradle",
          "maven"
        ]
      }
    },
    {
      "id": "python",
      "displayName": "Python",
      "file": "python.json",
      "classCount": 25,
      "detect": {
        "files": [
          "pyproject.toml",
          "requirements.txt",
          "setup.cfg",
          "uv.lock",
          "poetry.lock",
          "pdm.lock",
          "tox.ini"
        ],
        "extensions": [
          ".py",
          ".pyi"
        ],
        "commentSyntax": {
          ".py": "hash",
          ".pyi": "hash"
        },
        "packageManagers": [
          "pip",
          "uv",
          "poetry",
          "pdm"
        ]
      }
    },
    {
      "id": "rust",
      "displayName": "Rust (cargo / Cargo.toml / workspaces)",
      "file": "rust.json",
      "classCount": 23,
      "detect": {
        "files": [
          "Cargo.toml",
          "Cargo.lock",
          "rust-toolchain.toml"
        ],
        "extensions": [
          ".rs",
          ".toml"
        ],
        "commentSyntax": {
          ".rs": "slash",
          ".toml": "hash"
        },
        "packageManagers": [
          "cargo",
          "rustup"
        ]
      }
    }
  ]
}
